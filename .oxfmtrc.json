{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agents",
    ".claude",
    "package-lock.json",
    "pnpm-lock.json"
  ],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.yaml", "*.yml"],
      "options": { "printWidth": 80 }
    }
  ],
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva"],
    "stylesheet": "./src/app/globals.css"
  },
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
