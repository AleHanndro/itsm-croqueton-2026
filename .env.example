# Copia este archivo a .env.local y ajusta los valores.

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/croqueton
# Pon "true" para proveedores que exigen SSL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_SSL=false

# Superadmin que crea `pnpm db:migrate` la primera vez
SUPERADMIN_EMAIL=admin@croqueton.mx
SUPERADMIN_PASSWORD=croqueton2026
SUPERADMIN_NAME=Admin Croquetón

# Token para /api/cron/expire-blocks (Vercel Cron lo envía como Bearer)
CRON_SECRET=cambia-esto
