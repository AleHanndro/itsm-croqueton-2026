# Copia este archivo a .env.local y ajusta los valores.

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/croqueton
# Pon "true" para proveedores que exigen SSL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_SSL=false

# Superadmin que crea `pnpm db:migrate` la primera vez
SUPERADMIN_EMAIL=admin@croqueton.mx
SUPERADMIN_PASSWORD=croqueton2026
SUPERADMIN_NAME=Admin Croquetón

# Token para /api/cron/expire-blocks (Vercel Cron lo envía como Bearer)
CRON_SECRET=cambia-esto

# --- Correo (SMTP) ---
# Sin SMTP_HOST no se envía nada: los correos quedan como "skipped" en la tabla email_log.
# Gmail: smtp.gmail.com, puerto 465, SMTP_SECURE=true y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS directo); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Croquetón <no-reply@croqueton.mx>"
# Opcional: a dónde llegan las respuestas de los correos
MAIL_REPLY_TO=
# Opcional: URL pública del sitio, para el enlace del pie de los correos
SITE_URL=http://localhost:3000

# --- Colaboradores y evento (van en el correo de aceptación) ---
# Fecha, hora, lugar e indicaciones se editan en /admin/solicitudes; estas variables
# solo se usan si ese campo está vacío en el panel.
JOIN_CAPACITY=35
EVENT_NAME="Croquetón 2026"
EVENT_DATE="Por confirmar"
EVENT_TIME="Por confirmar"
EVENT_LOCATION="Por confirmar"
# Opcional: indicaciones extra (qué llevar, punto de reunión, etc.)
EVENT_DETAILS=

# --- Donaciones ---
# Pesos que equivalen a 1 kg de croqueta en el contador de la meta
DONATION_MXN_PER_KG=20
